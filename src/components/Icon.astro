---

{d ? (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <path d={d} />
  </svg>
) : (
  <span class={className} aria-hidden="true">?</span>
)}
