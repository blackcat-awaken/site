---
/**
 * 章節題頭 — 取代千篇一律的 SectionHead 置中卡式標題
 * 左靠、不對稱、序號漢字 + 巨字 + 細線
 */
interface Props {
  no: string; // 序、破、急、等等漢字
  en: string; // VERSION 14.1
  title: string;
  desc?: string;
  align?: 'left' | 'center';
}

const { no, en, title, desc, align = 'left' } = Astro.props;
const centered = align === 'center';
---

<div class:list={['relative', centered ? 'mx-auto max-w-3xl text-center' : 'mx-0 max-w-none text-left']}>
  <div class:list={['flex items-end gap-6', centered && 'justify-center']}>
    <span class="chapter-no text-[clamp(4rem,9vw,7.5rem)]" aria-hidden="true" data-reveal>{no}</span>
    <div class="pb-3">
      <p class="font-latin text-[11px] font-semibold tracking-[0.5em] text-crimson-400" data-reveal>{en}</p>
      <h2 class="mt-3 font-display text-3xl font-black leading-tight tracking-[0.08em] text-moon-100 md:text-5xl" data-chars data-reveal>
        {title}
      </h2>
    </div>
  </div>
  <div class:list={['rule-line-crimson mt-7 w-28', centered && 'mx-auto']} data-reveal="line" aria-hidden="true"></div>
  {desc && (
    <p class:list={['mt-6 max-w-xl text-[15px] leading-8 text-moon-300', centered && 'mx-auto']} data-reveal>
      {desc}
    </p>
  )}
</div>
