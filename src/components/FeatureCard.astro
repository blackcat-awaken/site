---
import type { Feature } from '../data/features';
import Icon from './Icon.astro';

/** 特色卡片：圖示 + 標題 + 說明 + 標籤 */
interface Props {
  feature: Feature;
  delay?: number;
}

const { feature, delay = 0 } = Astro.props;
---

<article
  class="ink-card group relative overflow-hidden rounded-sm p-7 hover:-translate-y-1.5"
  data-reveal
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex h-12 w-12 items-center justify-center border border-crimson-500/30 bg-crimson-600/10 text-crimson-300 transition-colors duration-300 group-hover:border-crimson-400/60 group-hover:bg-crimson-600/20">
      <Icon name={feature.icon} class="h-6 w-6" />
    </span>
    {feature.tag && (
      <span class="border border-gold-500/35 bg-gold-500/8 px-2.5 py-0.5 text-[11px] font-medium tracking-[0.22em] text-gold-300">
        {feature.tag}
      </span>
    )}
  </div>

  <h3 class="mt-6 font-display text-xl font-bold tracking-[0.1em] text-moon-100">{feature.title}</h3>
  <p class="mt-3 text-sm leading-7 text-moon-300">{feature.desc}</p>
</article>
