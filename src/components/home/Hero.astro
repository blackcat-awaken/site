---
import { site } from '../../data/site';
import Icon from '../Icon.astro';

/**
 * 首頁 Hero：
 * - 桌機：hero-main.mp4 播一次 → 淡出切換 8K 主視覺
 * - 行動裝置 / reduced-motion：直接顯示主視覺（見 scripts/site.ts）
 */
---

<section class="relative flex h-[100svh] min-h-[620px] flex-col overflow-hidden bg-ink-950" aria-label="主視覺">
  <noscript>
    <style>
      [data-hero-image] { opacity: 1 !important; }
      [data-hero-video] { display: none !important; }
    </style>
  </noscript>

  <!-- 8K 主視覺（預設隱藏防洩漏，轉場完成後由 site.ts 淡入；無 JS 時由 noscript 顯示） -->
  <div data-hero-image class="fade-media absolute inset-0 overflow-hidden opacity-0">
    <img
      data-hero-img
      src="/site/assets/img/keyart-hero.webp"
      alt="闇鴉武士 — 白髮武士立於血月之下"
      class="h-full w-full scale-105 object-cover object-center"
      style="will-change: filter, transform;"
      fetchpriority="high"
    />
  </div>

  <!-- 播一次的 CG 影片（不設 poster：第一幀出來前保持純墨黑，避免底圖先閃） -->
  <video
    data-hero-video
    class="absolute inset-0 h-full w-full object-cover"
    src="/site/assets/video/hero-main.mp4"
    autoplay
    muted
    playsinline
    webkit-playsinline
    preload="auto"
    aria-hidden="true"
  ></video>

  <!-- 墨浪橫掃層：GPU 硬體加速 translate3d 刀幕（由右下至左上吞沒畫面，自帶墨鋒羽化） -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      data-hero-curtain
      class="absolute left-1/2 top-1/2 h-[340vmax] w-[340vmax] bg-ink-950 shadow-[-60px_0_80px_rgb(11_11_16)]"
      style="transform: translate3d(-50%, -50%, 0) rotate(-35deg) translate3d(85%, 0, 0); will-change: transform, opacity; backface-visibility: hidden;"
    ></div>
  </div>

  <!-- 墨色壓暗 + 漸層收尾 -->
  <div class="absolute inset-0 bg-gradient-to-b from-ink-950/72 via-ink-950/24 to-ink-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(76%_60%_at_50%_42%,transparent_45%,rgb(6_6_9_/_0.66)_100%)]" aria-hidden="true"></div>

  <!-- 直式書法標題 -->
  <div class="pointer-events-none absolute right-[6%] top-1/2 hidden -translate-y-1/2 select-none md:block" aria-hidden="true">
    <div class="relative">
      <!-- 主標：右側大字 -->
      <p class="vertical-rl font-display text-[clamp(3rem,11vh,5.5rem)] font-black leading-none text-moon-100/92 drop-shadow-[0_6px_26px_rgb(0_0_0_/_0.85)]" data-reveal>
        闇鴉武士
      </p>

      <!-- 副標：絕對定位于「士」字左側，向下延展至底部（單直列不折行） -->
      <p
        class="vertical-rl whitespace-nowrap absolute right-full top-[86%] mr-5 text-[12.5px] font-medium tracking-[0.32em] text-crimson-400 drop-shadow-[0_2px_12px_rgb(0_0_0_/_0.95)]"
        data-reveal
        style="--reveal-delay:250ms"
      >
        刀起墨落・鴉羽蔽月
      </p>
    </div>
  </div>

  <!-- 左側主要文案（垂直置中） -->
  <div class="relative z-[2] mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-5 md:px-8">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2.5 border border-moon-100/15 bg-ink-950/55 px-4 py-1.5 text-[11px] font-medium tracking-[0.34em] text-moon-200 backdrop-blur-sm" data-reveal>
        <span class="ember inline-block h-1.5 w-1.5 rounded-full bg-crimson-400"></span>
        {site.version} {site.title} · SAMURAI CROW
      </p>

      <h1 class="mt-6 font-display text-4xl font-black leading-[1.28] tracking-[0.08em] text-moon-100 md:hidden" data-reveal>
        闇鴉武士<br />
        <span class="text-gradient-crimson">刀起墨落，鴉羽蔽月</span>
      </h1>
      <h1 class="mt-7 hidden font-display font-black tracking-[0.06em] md:block" data-reveal style="--reveal-delay:120ms">
        <span class="text-gradient-ink block text-[clamp(2.6rem,5vw,4.2rem)] leading-none">黑貓神話</span>
        <span class="mt-5 flex items-center gap-4 text-[clamp(1rem,1.7vw,1.35rem)] font-bold tracking-[0.42em] text-crimson-300">
          <span class="inline-block h-px w-12 bg-gradient-to-r from-crimson-500 to-transparent" aria-hidden="true"></span>14.1 全新版本降臨
        </span>
      </h1>
    </div>
  </div>

  <!-- 行動按鈕（貼底） -->
  <div class="relative z-[2] mx-auto w-full max-w-7xl px-5 pb-16 md:px-8 md:pb-20">
    <div class="flex flex-wrap items-center gap-x-9 gap-y-4" data-reveal style="--reveal-delay:220ms">
      <a
        href="/site/download"
        class="pulse-glow group inline-flex items-center gap-2.5 bg-crimson-600 px-8 py-4 text-[15px] font-bold tracking-[0.2em] text-moon-100 transition-colors duration-300 hover:bg-crimson-500"
      >
        <Icon name="download" class="h-4.5 w-4.5 transition-transform duration-300 group-hover:translate-y-0.5" />
        免費下載遊戲
      </a>
      <a
        href={site.links.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2.5 py-4 text-[15px] tracking-[0.2em] text-moon-200 transition-colors duration-300 hover:text-moon-100"
      >
        <Icon name="discord" class="h-5 w-5 text-moon-300 transition-colors duration-300 group-hover:text-crimson-300" />
        加入 Discord
        <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <!-- 下滑提示（桌機限定，避免與貼底按鈕重疊） -->
  <div class="absolute bottom-7 left-1/2 z-[2] hidden -translate-x-1/2 text-moon-300/70 md:block" data-reveal style="--reveal-delay:600ms" aria-hidden="true">
    <div class="flex flex-col items-center gap-2">
      <span class="font-latin text-[10px] tracking-[0.4em]">SCROLL</span>
      <span class="float-y inline-block h-9 w-px bg-gradient-to-b from-crimson-400/80 to-transparent"></span>
    </div>
  </div>
</section>
