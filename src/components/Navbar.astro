---
import { site } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/site/' || href === '/'
    ? pathname === '/site/' || pathname === '/site' || pathname === '/'
    : pathname.startsWith(href);
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-moon-100/8 bg-ink-950/72 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 md:h-[72px] md:px-8" aria-label="主選單">
    <a href="/site/" class="group flex items-center gap-3">
      <img src="/site/favicon.png" alt="黑貓神話徽記" width="36" height="36" class="rounded-lg transition-transform duration-500 group-hover:rotate-[-8deg]" />
      <span class="leading-none">
        <span class="block font-display text-lg font-bold tracking-[0.3em] text-moon-100">黑貓神話</span>
        <span class="mt-0.5 block font-latin text-[10px] font-semibold tracking-[0.34em] text-crimson-400">SAMURAI CROW</span>
      </span>
    </a>

    <ul data-desktop-nav class="hidden items-center gap-1 lg:flex">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-md px-3.5 py-2 text-[13.5px] tracking-[0.16em] transition-colors duration-300',
              isActive(item.href)
                ? 'text-crimson-300'
                : 'text-moon-300 hover:text-moon-100',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3.5 -bottom-px h-px bg-gradient-to-r from-transparent via-crimson-500 to-transparent"></span>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        data-nav-cta
        href={site.links.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="pulse-glow hidden items-center gap-2 rounded-sm border border-crimson-500/45 bg-crimson-600/15 px-4 py-2 text-[13px] font-medium tracking-[0.14em] text-crimson-300 transition-colors duration-300 hover:bg-crimson-600/30 hover:text-moon-100 sm:inline-flex"
      >
        <Icon name="discord" class="h-4 w-4" />
        立即加入
      </a>
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-label="開啟選單"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-moon-100/12 text-moon-200 transition-colors hover:border-crimson-500/50 hover:text-moon-100 lg:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </nav>
</header>

<!-- 手機全屏選單 -->
<div
  data-nav-menu
  data-open="false"
  class="fixed inset-0 z-40 hidden flex-col bg-ink-950/97 pt-24 backdrop-blur-2xl data-[open=true]:flex lg:hidden"
>
  <ul class="mx-auto flex w-full max-w-sm flex-col items-center gap-2 px-8">
    {site.nav.map((item, i) => (
      <li class="w-full" style={`--reveal-delay:${i * 60}ms`}>
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'flex items-baseline justify-between border-b border-moon-100/8 py-5 font-display text-2xl tracking-[0.24em]',
            isActive(item.href) ? 'text-crimson-300' : 'text-moon-200 hover:text-moon-100',
          ]}
        >
          {item.label}
          <span class="font-latin text-[10px] tracking-[0.3em] text-moon-600">0{i + 1}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="mx-auto mt-10 flex gap-4">
    <a
      href={site.links.discord}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-sm border border-crimson-500/45 bg-crimson-600/15 px-6 py-3 tracking-[0.14em] text-crimson-300"
    >
      <Icon name="discord" class="h-4 w-4" />
      Discord
    </a>
    <a
      href={site.links.facebook}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-sm border border-moon-100/15 px-6 py-3 tracking-[0.14em] text-moon-300"
    >
      <Icon name="facebook" class="h-4 w-4" />
      Facebook
    </a>
  </div>
</div>
