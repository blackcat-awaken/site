---
/**
 * 內頁頁首橫幅：背景圖 + 眉批 + 書法大標 + 說明，右下襯一行空心英文巨字，底邊一條墨線。
 * 高度由 global.css 的 .page-banner 統一控制。
 * 說明文字下方可以再放自訂內容（例如攻略百科的搜尋列），直接寫在 <PageHero>…</PageHero> 之間即可。
 */
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  image: string;
  imageAlt?: string;
  /** 背景圖取景位置。橫幅是橫長條，請用 object-[x_y] 指定要露出的那一段 */
  imagePosition?: string;
  /** 右下空心巨字，預設取 eyebrow 的第一個單字 */
  mark?: string;
  anchors?: { href: string; label: string }[];
}

const {
  eyebrow,
  title,
  desc,
  image,
  imageAlt = '',
  imagePosition = 'object-center',
  mark,
  anchors = [],
} = Astro.props;

const markText = mark ?? eyebrow.split(' ')[0];
---

<section class="page-banner relative flex items-end overflow-hidden pt-[calc(4rem*var(--nav-k,1))] md:pt-[calc(72px*var(--nav-k,1))]" aria-label={title}>
  <img
    src={image}
    alt={imageAlt}
    fetchpriority="high"
    class:list={['absolute inset-x-0 top-[calc(72px*(var(--nav-k,1)_-_1))] h-[calc(100%_-_72px*(var(--nav-k,1)_-_1))] w-full object-cover', imagePosition]}
  />
  <div class="absolute inset-0 bg-gradient-to-b from-ink-950/55 via-ink-950/15 to-ink-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-ink-950/85 via-ink-950/25 to-transparent" aria-hidden="true"></div>

  <p
    aria-hidden="true"
    class="outline-faint pointer-events-none absolute -bottom-[0.58em] right-[-0.03em] select-none whitespace-nowrap font-latin text-[clamp(4rem,9.5vw,8.5rem)] font-black leading-none tracking-[0.02em]"
  >
    {markText}
  </p>

  <div class="relative mx-auto w-full max-w-7xl px-5 pb-10 pt-10 md:px-8 md:pb-12 md:pt-12">
    <p class="flex items-center gap-4 font-latin text-xs font-semibold tracking-[0.44em] text-crimson-400" data-reveal>
      <span class="h-px w-10 bg-crimson-500" aria-hidden="true"></span>{eyebrow}
    </p>
    <h1 class="mt-3 font-display text-4xl font-black leading-tight tracking-[0.1em] text-moon-100 drop-shadow-[0_6px_30px_rgb(0_0_0_/_0.7)] md:text-6xl" data-reveal style="--reveal-delay:100ms">
      {title}
    </h1>
    {desc && (
      <p class="mt-4 max-w-2xl text-[15px] leading-7 text-moon-200/90" data-reveal style="--reveal-delay:200ms">{desc}</p>
    )}
    {anchors.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-3" data-reveal style="--reveal-delay:280ms">
        {anchors.map((a) => (
          <a
            href={a.href}
            class="inline-flex items-center gap-2 rounded-sm border border-moon-100/20 bg-ink-950/45 px-4 py-2 text-xs font-medium tracking-[0.22em] text-moon-200 backdrop-blur-sm transition-colors duration-300 hover:border-crimson-400/60 hover:text-moon-100"
          >
            <span class="h-1 w-1 rounded-full bg-crimson-400"></span>
            {a.label}
          </a>
        ))}
      </div>
    )}
    <slot />
  </div>
  <div class="ink-divider absolute inset-x-0 bottom-0" aria-hidden="true"></div>
</section>
