---
/** 內頁頁首：背景圖 + 眉批 + 書法大標 + 說明 */
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  anchors?: { href: string; label: string }[];
}

const {
  eyebrow,
  title,
  desc,
  image,
  imageAlt = '',
  imagePosition = 'object-center',
  anchors = [],
} = Astro.props;
---

<section class="relative flex min-h-[52svh] items-end overflow-hidden pt-16" aria-label={title}>
  <img
    src={image}
    alt={imageAlt}
    fetchpriority="high"
    class:list={['absolute inset-0 h-full w-full object-cover', imagePosition]}
  />
  <div class="absolute inset-0 bg-gradient-to-b from-ink-950/80 via-ink-950/38 to-ink-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(70%_60%_at_30%_80%,transparent_30%,rgb(6_6_9_/_0.55)_100%)]" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-7xl px-5 pb-16 pt-28 md:px-8 md:pb-20">
    <p class="font-latin text-xs font-semibold tracking-[0.44em] text-crimson-400" data-reveal>{eyebrow}</p>
    <h1 class="mt-4 font-display text-4xl font-black tracking-[0.1em] text-moon-100 md:text-6xl" data-reveal style="--reveal-delay:120ms">
      {title}
    </h1>
    {desc && (
      <p class="mt-5 max-w-2xl text-[15px] leading-8 text-moon-300" data-reveal style="--reveal-delay:220ms">{desc}</p>
    )}
    {anchors.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-3" data-reveal style="--reveal-delay:320ms">
        {anchors.map((a) => (
          <a
            href={a.href}
            class="inline-flex items-center gap-2 rounded-sm border border-moon-100/20 bg-ink-950/45 px-4 py-2 text-xs font-medium tracking-[0.22em] text-moon-200 backdrop-blur-sm transition-colors duration-300 hover:border-crimson-400/60 hover:text-moon-100"
          >
            <span class="h-1 w-1 rounded-full bg-crimson-400"></span>
            {a.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>
