---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="聯絡我們" description="透過 Discord 或 Facebook 聯絡黑貓神話營運團隊。伺服器規格、維護時間與最新公告一覽。">
  <PageHero
    eyebrow="CONTACT"
    title="聯絡我們"
    desc="有任何問題、建議或合作提案？透過以下社群管道與我們聯繫，營運團隊隨時在線。"
    image="/site/assets/img/samurai-crow.webp"
    imageAlt="水墨武士與黑鴉飛揚"
    imagePosition="object-top"
  />

  <!-- 社群管道 -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28" aria-labelledby="channels">
    <div class="grid gap-6 md:grid-cols-2 md:gap-8">
      <!-- Discord -->
      <a
        href={site.links.discord}
        target="_blank"
        rel="noopener noreferrer"
        class="ink-card group relative flex flex-col overflow-hidden p-8 transition-transform duration-500 hover:-translate-y-1.5 md:p-10"
        data-reveal="left"
      >
        <span class="absolute inset-x-0 top-0 h-[2px] origin-left scale-x-0 bg-gradient-to-r from-crimson-500 via-crimson-400/70 to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
        <span class="chapter-no pointer-events-none absolute right-5 top-4 text-[4rem] md:text-[5rem]" aria-hidden="true">01</span>
        <span class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-crimson-600/12 blur-3xl transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
        <div class="relative flex items-center gap-4">
          <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center border border-crimson-500/35 bg-crimson-600/12 text-crimson-300 transition-colors duration-500 group-hover:bg-crimson-600/25">
            <Icon name="discord" class="h-7 w-7" />
          </span>
          <span>
            <span class="font-latin block text-[10px] font-semibold tracking-[0.34em] text-crimson-400">DISCORD · 主要聯絡管道</span>
            <span class="mt-1.5 block font-display text-2xl font-black tracking-[0.08em] text-moon-100">Discord 官方社群</span>
          </span>
        </div>
        <span class="relative mt-5 block flex-1 text-sm leading-7 text-moon-300">
          最新公告、遊戲問題回報、中文化支援、組隊招募 — 所有重要資訊都會第一時間在 Discord 發佈。加入後請先閱讀版規。
        </span>
        <span class="relative mt-7 inline-flex items-center gap-2.5 self-start bg-crimson-600 px-7 py-3.5 text-sm font-bold tracking-[0.18em] text-moon-100 transition-colors duration-300 group-hover:bg-crimson-500">
          <Icon name="discord" class="h-4.5 w-4.5" />
          立即加入 Discord
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </span>
      </a>

      <!-- Facebook -->
      <a
        href={site.links.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="ink-card group relative flex flex-col overflow-hidden p-8 transition-transform duration-500 hover:-translate-y-1.5 md:p-10"
        data-reveal="right"
      >
        <span class="absolute inset-x-0 top-0 h-[2px] origin-left scale-x-0 bg-gradient-to-r from-crow-500 via-moon-300/50 to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></span>
        <span class="chapter-no pointer-events-none absolute right-5 top-4 text-[4rem] md:text-[5rem]" aria-hidden="true">02</span>
        <span class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-crow-500/12 blur-3xl transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
        <div class="relative flex items-center gap-4">
          <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center border border-crow-500/40 bg-crow-500/10 text-crow-500 transition-colors duration-500 group-hover:bg-crow-500/20">
            <Icon name="facebook" class="h-7 w-7" />
          </span>
          <span>
            <span class="block text-[10px] font-medium tracking-[0.34em] text-moon-500">FACEBOOK · 分享交流</span>
            <span class="mt-1.5 block font-display text-2xl font-black tracking-[0.08em] text-moon-100">Facebook 社團</span>
          </span>
        </div>
        <span class="relative mt-5 block flex-1 text-sm leading-7 text-moon-300">
          玩家心得分享、活動截圖、版本更新摘要。歡迎分享你的遊戲截圖與戰績，與更多玩家交流互動。
        </span>
        <span class="relative mt-7 inline-flex items-center gap-2.5 self-start border border-crow-500/45 bg-crow-500/10 px-7 py-3.5 text-sm font-bold tracking-[0.18em] text-moon-200 transition-colors duration-300 group-hover:bg-crow-500/20 group-hover:text-moon-100">
          <Icon name="facebook" class="h-4.5 w-4.5" />
          前往 FB 社團
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </span>
      </a>
    </div>
  </section>

  <!-- 伺服器規格 -->
  <section class="relative py-20 md:py-28" aria-labelledby="server-specs">
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-900/50 to-ink-950" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-5 md:px-8">
      <SectionHead
        eyebrow="SERVER INFO"
        title="伺服器規格"
        desc="透明的伺服器資訊，是我們對玩家的承諾。以下資料均經過官方設定檔驗證。"
      />
      <div class="ink-frame mt-14 overflow-hidden rounded-sm" data-reveal="zoom">
        <ul>
          {site.stats.specs.map(([k, v], i) => (
            <li class:list={['flex flex-col gap-1 px-6 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6', i % 2 === 0 && 'bg-ink-900/40', 'border-b border-moon-100/6 last:border-b-0']}>
              <span class="shrink-0 text-sm tracking-[0.18em] text-moon-500">{k}</span>
              <span class="text-sm tracking-[0.06em] text-moon-200 sm:text-right">{v}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-8 text-center text-xs leading-6 tracking-[0.08em] text-moon-500" data-reveal>
        資料最近驗證日：2026-09-05 · 若有異動將於 Discord 公告
      </p>
    </div>
  </section>

  <!-- 免責聲明 -->
  <section class="mx-auto max-w-3xl px-5 pb-24 text-center md:px-8" aria-label="免責聲明">
    <p class="text-xs leading-7 text-moon-600" data-reveal>
      天堂II（Lineage II）為 NCSOFT Corporation 之註冊商標與版權所有。本站與 NCSOFT 無任何隸屬、贊助或背書關係。
      本站為非官方粉絲網站，僅提供玩家交流與遊戲資訊分享。
    </p>
  </section>
</Base>

