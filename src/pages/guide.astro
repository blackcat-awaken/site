---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ChapterHead from '../components/ChapterHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { faqs } from '../data/faq';

const steps = [
  {
    number: '壹',
    title: '下載主程式',
    desc: '前往下載專區，取得完整遊戲客戶端（約 15 GB）。建議使用穩定網路環境，下載期間請勿關閉瀏覽器。',
    href: '/site/download',
    cta: '前往下載',
  },
  {
    number: '貳',
    title: '解壓縮安裝',
    desc: '將下載的壓縮檔完整解壓至英文路徑（如 D:\\Lineage2），請避免中文或特殊符號路徑，以免啟動異常。',
  },
  {
    number: '參',
    title: '覆蓋最新補丁',
    desc: '下載最新登錄補丁，解壓後完整覆蓋至遊戲目錄。每次更新公告後，務必套用最新補丁才能登入。',
  },
  {
    number: '肆',
    title: '啟動並加入社群',
    desc: '執行遊戲啟動器、註冊帳號即可進入亞丁大陸。加入 Discord 獲得即時協助與最新公告。',
    href: site.links.discord,
    cta: '加入 Discord',
  },
] as const;
---

<Base title="加入教學" description="四個步驟加入黑貓神話 14.1 闇鴉武士：下載主程式、解壓縮、套用補丁、啟動遊戲。附完整影音教學與常見問題解答。">
  <PageHero
    eyebrow="GETTING STARTED"
    title="加入教學"
    desc="從下載到進入亞丁大陸，只需要四個步驟。跟著教學走，十分鐘內開始你的傳說。"
    image="/site/assets/img/visual-ink-samurai.webp"
    imageAlt="水墨筆觸下的武士背影"
  />

  <!-- 四步驟 → 參道時間軸 -->
  <section class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-32" aria-labelledby="steps">
    <ChapterHead
      no="道"
      en="4 STEPS"
      title="四步加入戰場"
      desc="每個步驟都經過簡化，即使是第一次接觸天堂II 私服的玩家也能輕鬆上手。"
    />

    <ol class="relative mt-16" data-timeline>
      <div class="timeline-rail left-4 md:left-1/2" aria-hidden="true">
        <div class="timeline-growth" data-timeline-growth></div>
      </div>
      {steps.map((s, i) => (
        <li class:list={[
          'relative grid gap-6 pb-16 pl-14 last:pb-0 md:grid-cols-2 md:gap-16 md:pl-0',
        ]} data-reveal>
          <span class="absolute left-4 top-2 h-3 w-3 -translate-x-1/2 rotate-45 bg-crimson-500 shadow-[0_0_14px_rgb(224_70_60/0.7)] md:left-1/2" aria-hidden="true"></span>
          <div class:list={[
            'md:text-right',
            i % 2 === 1 && 'md:order-2 md:text-left',
          ]}>
            <p class="font-latin text-xs tracking-[0.4em] text-crimson-400">STEP 0{i + 1}</p>
            <p class="chapter-no mt-1 text-6xl md:text-7xl" aria-hidden="true">{s.number}</p>
            <h3 class="mt-2 font-display text-2xl font-black tracking-[0.1em] text-moon-100 md:text-3xl">{s.title}</h3>
          </div>
          <div class:list={['md:pt-10', i % 2 === 1 && 'md:order-1 md:text-right']}>
            <p class="max-w-md text-[15px] leading-8 text-moon-300 md:inline-block md:text-left">{s.desc}</p>
            {'href' in s && s.href && (
              <div class="mt-5">
                <a
                  href={s.href}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  data-magnetic
                  class="group inline-flex items-center gap-2.5 border-b border-crimson-500/50 pb-1 text-sm font-medium tracking-[0.22em] text-crimson-300 transition-colors hover:text-moon-100"
                >
                  {'cta' in s ? s.cta : '前往'}
                  <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
                </a>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 影音教學 -->
  <section class="relative py-20 md:py-32" aria-labelledby="video-guide">
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-900/50 to-ink-950" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-5xl px-5 md:px-8">
      <ChapterHead
        no="影"
        en="VIDEO GUIDE"
        title="影音教學"
        desc="跟著影片操作，一步一步完成安裝，安全又快速。"
        align="center"
      />
      <div class="ink-frame mt-14 overflow-hidden" data-reveal="clip">
        <div class="aspect-video w-full bg-ink-900">
          <iframe
            src={site.links.guideVideo}
            title="黑貓神話 闇鴉武士 — 遊戲安裝教學影片"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
            class="h-full w-full"
          ></iframe>
        </div>
      </div>
      <p class="mt-4 text-center text-xs tracking-[0.14em] text-moon-500" data-reveal>
        影片無法播放？<a href={site.links.guideVideo.replace('youtube-nocookie.com/embed', 'youtube.com/watch')} target="_blank" rel="noopener noreferrer" class="text-crimson-300 underline underline-offset-4 hover:text-moon-100">直接前往 YouTube 觀看</a>
      </p>
    </div>
  </section>

  <!-- FAQ — 去卡片，一線一問 -->
  <section class="mx-auto max-w-4xl px-5 py-20 md:px-8 md:py-32" aria-labelledby="faq">
    <ChapterHead
      no="問"
      en="FAQ"
      title="常見問題"
      desc="找不到答案嗎？加入 Discord 社群，管理團隊與熱心玩家隨時為你解答。"
      align="center"
    />

    <div class="mt-14 divide-y divide-moon-100/8 border-y border-moon-100/8">
      {faqs.map((f, i) => (
        <details
          data-faq
          class="group"
          data-reveal
          style={`--reveal-delay:${i * 40}ms`}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 [&::-webkit-details-marker]:hidden">
            <span class="flex items-baseline gap-5">
              <span class="tnum font-latin text-sm font-bold text-crimson-500">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-base font-bold tracking-[0.06em] text-moon-100 md:text-lg">{f.q}</span>
            </span>
            <Icon name="chevron" class="h-5 w-5 shrink-0 text-moon-500 transition-transform duration-300 group-open:rotate-180 group-open:text-crimson-300" />
          </summary>
          <p class="pb-7 pl-0 text-sm leading-8 text-moon-300 md:pl-12 md:text-[15px]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>

