---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ChapterHead from '../components/ChapterHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { dragonTrial } from '../data/events';
import { newSystems141, privilegeFeatures, convenienceFeatures, gameplayFeatures } from '../data/features';
import { wikiArticles, wikiMeta, pageUrl, WIKI_DB } from '../data/wiki';

const highlights = [
  privilegeFeatures[0], // VIP 尊榮系統
  convenienceFeatures[0], // 自動喝水系統
  convenienceFeatures[1], // 社群面板
  gameplayFeatures[0], // 離線擺攤
  gameplayFeatures[1], // 冠軍怪物系統
  privilegeFeatures[3], // 自動拾取道具
];

const kanji = ['壹', '貳', '參', '肆'];
const fmt = (n: number) => n.toLocaleString('en-US');

const wikiStats = [
  { value: String(wikiArticles.length), unit: '篇', label: '攻略文章' },
  { value: fmt(wikiMeta.items), unit: '件', label: '道具資料' },
  { value: fmt(wikiMeta.mobs), unit: '種', label: '怪物掉落' },
];
const wikiHot = ['newbie', 'enchant', 'instances', 'bosses']
  .map((id) => wikiArticles.find((p) => p.id === id))
  .filter((p) => !!p);
---

<Base>
  <Hero />

  <!-- 數據帳冊 -->
  <section class="relative border-y border-moon-100/8 bg-ink-900/45 backdrop-blur-sm" aria-label="伺服器數據">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-crimson-500/60 to-transparent" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-7xl grid-cols-3 px-5 md:px-8 lg:grid-cols-6">
      {site.stats.rates.map((r, i) => (
        <div class="stat-cell px-3 py-10 text-center md:py-12" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <p class="tnum font-display text-[2.75rem] font-black leading-none tracking-wide text-moon-100 xl:text-5xl">
            <span class="sr-only">{r.value}</span>
            <span data-count={r.value} aria-hidden="true">{r.value}</span><span class="text-crimson-400" aria-hidden="true">{r.suffix}</span>
            {r.suffix && <span class="sr-only">{r.suffix}</span>}
          </p>
          <p class="mt-4 text-[13px] tracking-[0.3em] text-moon-300">{r.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 14.1 新系統：四柱 -->
  <section class="relative mx-auto max-w-7xl px-5 pb-20 pt-24 md:px-8 md:pb-24 md:pt-32" aria-labelledby="new-systems">
    <ChapterHead
      no="序"
      id="new-systems"
      en="VERSION 14.1"
      title="闇鴉武士・全新系統"
      desc="轉生系統、附魔挑戰、龍之試煉 — 14.1 帶來的嶄新戰場，等你親手寫下新的傳說。"
    />
    <ol class="mt-16 grid border-y border-moon-100/10 sm:grid-cols-2 lg:grid-cols-4">
      {newSystems141.map((f, i) => (
        <li
          class:list={[
            'pillar group flex flex-col px-7 pb-10 pt-9',
            i > 0 && 'lg:border-l lg:border-moon-100/10',
            i % 2 === 1 && 'max-lg:sm:border-l max-lg:sm:border-moon-100/10',
            i >= 2 && 'max-lg:sm:border-t max-lg:sm:border-moon-100/10',
            i >= 1 && 'max-sm:border-t max-sm:border-moon-100/10',
          ]}
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div class="flex items-start justify-between">
            <span class="inline-flex h-12 w-12 items-center justify-center border border-crimson-500/35 bg-crimson-600/10 text-crimson-300 transition-colors duration-500 group-hover:border-crimson-400/70 group-hover:bg-crimson-600/20">
              <Icon name={f.icon} class="h-6 w-6" />
            </span>
            <span class="chapter-no -mr-1 -mt-2 text-[4.5rem]" aria-hidden="true">{kanji[i]}</span>
          </div>
          {f.tag && (
            <p class="mt-8 flex items-center gap-2.5 text-[11px] font-medium tracking-[0.3em] text-gold-300">
              <span class="h-1 w-1 rotate-45 bg-gold-400" aria-hidden="true"></span>{f.tag}
            </p>
          )}
          <h3 class="mt-3 font-display text-[1.6rem] font-black tracking-[0.1em] text-moon-100">{f.title}</h3>
          <p class="mt-4 text-[15px] leading-8 text-moon-300">{f.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 特色預覽：主視覺 + 清單 -->
  <section class="relative overflow-hidden py-20 md:py-28" aria-labelledby="feature-preview">
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-900/55 to-ink-950" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-40 top-1/3 h-[34rem] w-[34rem] rounded-full bg-crimson-600/10 blur-[120px]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
      <ChapterHead
        no="技"
        id="feature-preview"
        en="FEATURES"
        title="為玩家而生的細節"
        desc="從自動喝水到離線擺攤，每一項設計都為了讓你專注於戰鬥與冒險本身。"
      />

      <div class="mt-16 grid items-stretch gap-12 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1fr)] lg:gap-16">
        <figure class="media-frame relative min-h-[26rem] overflow-hidden lg:min-h-0" data-reveal="clip">
          <img
            src="/site/assets/img/scene-torii.webp"
            alt="鴉之村的朱紅鳥居參道，兩側櫻花盛開"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-[2.4s] ease-out hover:scale-[1.05]"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/20 to-ink-950/45" aria-hidden="true"></div>
          <p class="vertical-rl pointer-events-none absolute right-8 top-9 text-[13px] font-medium tracking-[0.5em] text-moon-100/80 drop-shadow-[0_2px_10px_rgb(0_0_0_/_0.9)]" aria-hidden="true">
            為玩家而生
          </p>
          <figcaption class="pointer-events-none absolute inset-x-9 bottom-9">
            <p class="font-latin text-[10px] font-semibold tracking-[0.44em] text-crimson-300">SAMURAI CROW</p>
            <p class="mt-2 font-display text-2xl font-black tracking-[0.18em] text-moon-100 drop-shadow-[0_4px_18px_rgb(0_0_0_/_0.9)]">{site.slogan}</p>
          </figcaption>
        </figure>

        <div class="flex flex-col">
          <ol class="divide-y divide-moon-100/8 border-y border-moon-100/8">
            {highlights.map((f, i) => (
              <li class="list-row group flex items-center gap-5 py-5" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-moon-100/12 text-crimson-300 transition-colors duration-500 group-hover:border-crimson-500/50 group-hover:bg-crimson-600/10">
                  <Icon name={f.icon} class="h-[22px] w-[22px]" />
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="flex flex-wrap items-center gap-3 font-display text-lg font-bold tracking-[0.08em] text-moon-100">
                    {f.title}
                    {f.tag && (
                      <span class="border border-gold-500/35 px-2 py-0.5 font-body text-[11px] font-medium tracking-[0.24em] text-gold-300">{f.tag}</span>
                    )}
                  </h3>
                  <p class="mt-1 text-sm leading-7 text-moon-300">{f.desc}</p>
                </div>
                <span class="tnum hidden font-latin text-xs tracking-[0.2em] text-moon-600 sm:block" aria-hidden="true">0{i + 1}</span>
              </li>
            ))}
          </ol>
          <div class="mt-9" data-reveal>
            <a href="/site/features" class="link-arrow group text-[15px]">
              瀏覽全部特色系統
              <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 攻略百科入口 -->
  <section class="relative mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-24" aria-labelledby="wiki-entry">
    <div class="ink-frame relative overflow-hidden bg-ink-900/60" data-reveal>
      <img
        src="/site/assets/img/scene-hall.webp"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="pointer-events-none absolute inset-y-0 right-0 h-full w-[60%] object-cover object-[50%_62%] [mask-image:linear-gradient(to_right,transparent,black_40%)]"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/45 to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-crimson-600/12 blur-3xl" aria-hidden="true"></div>

      <div class="relative grid gap-12 px-8 py-12 md:px-14 md:py-16 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16">
        <div>
          <p class="flex items-center gap-4 font-latin text-xs font-semibold tracking-[0.44em] text-crimson-400">
            <span class="h-px w-10 bg-crimson-500" aria-hidden="true"></span>FIELD MANUAL
          </p>
          <h2 id="wiki-entry" class="mt-5 font-display text-4xl font-black leading-tight tracking-[0.08em] text-moon-100 md:text-5xl">攻略百科，一查就懂</h2>
          <p class="mt-5 max-w-xl text-[15px] leading-8 text-moon-300">
            新手照著做，老手直接查。攻略文章加上道具、怪物掉落、商店等 9 大資料庫，數值全部取自伺服器實際設定。
          </p>

          <dl class="mt-9 flex flex-wrap gap-x-12 gap-y-6">
            {wikiStats.map((s) => (
              <div>
                <dd class="tnum font-display text-4xl font-black leading-none text-moon-100">
                  {s.value}<span class="ml-1.5 text-base font-bold text-crimson-400">{s.unit}</span>
                </dd>
                <dt class="mt-2.5 text-[13px] tracking-[0.26em] text-moon-400">{s.label}</dt>
              </div>
            ))}
          </dl>

          <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm tracking-[0.1em]">
            <span class="font-latin text-[10px] font-semibold tracking-[0.36em] text-moon-500">HOT</span>
            {wikiHot.map((p) => (
              <a href={pageUrl(p!.id)} class="text-moon-200 underline decoration-moon-100/20 underline-offset-[6px] transition-colors hover:text-crimson-300 hover:decoration-crimson-400/60">{p!.title}</a>
            ))}
            <a href={`${WIKI_DB}#db-items`} class="text-moon-200 underline decoration-moon-100/20 underline-offset-[6px] transition-colors hover:text-crimson-300 hover:decoration-crimson-400/60">道具資料庫</a>
          </div>
        </div>

        <a href="/site/wiki" class="btn btn-line group w-fit rounded-sm px-8 py-4 text-[15px]">
          開始閱讀攻略
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- 龍之試煉預告 -->
  <section class="relative overflow-hidden py-32 md:py-44" aria-labelledby="dragon-teaser">
    <video
      data-bg-video
      class="absolute inset-x-0 top-px h-[calc(100%-2px)] w-full object-cover"
      src="/site/assets/video/dragon.mp4"
      poster={dragonTrial.poster}
      loop
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 bg-ink-950/62" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-transparent to-ink-950" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(60%_55%_at_50%_50%,transparent_30%,rgb(6_6_9_/_0.6)_100%)]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-5 text-center md:px-8">
      <p class="inline-flex items-center gap-2.5 border border-gold-500/45 bg-ink-950/60 px-5 py-2 text-[13px] font-medium tracking-[0.32em] text-gold-300 backdrop-blur-sm" data-reveal>
        <span class="ember inline-block h-1.5 w-1.5 rounded-full bg-gold-300" aria-hidden="true"></span>
        {dragonTrial.badge}
      </p>
      <h2 id="dragon-teaser" class="mt-7 font-display text-5xl font-black tracking-[0.1em] text-moon-100 drop-shadow-[0_8px_40px_rgb(0_0_0_/_0.8)] md:text-7xl" data-reveal style="--reveal-delay:120ms">
        龍之試煉<span class="text-crimson-400">・絕</span>
      </h2>
      <p class="mx-auto mt-7 max-w-2xl text-base leading-8 text-moon-200/90" data-reveal style="--reveal-delay:220ms">
        {dragonTrial.intro}
      </p>

      <ul class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-px border border-moon-100/10 bg-moon-100/10 sm:grid-cols-4" data-reveal style="--reveal-delay:320ms">
        {dragonTrial.bosses.map((b) => (
          <li class="relative bg-ink-950/78 px-4 py-5 backdrop-blur-sm">
            <span class="absolute inset-x-0 top-0 h-[2px]" style={`background:linear-gradient(90deg,transparent,${b.color},transparent)`} aria-hidden="true"></span>
            <p class="text-[13px] tracking-[0.3em]" style={`color:${b.color}`}>{b.title}</p>
            <p class="mt-1.5 font-display text-lg font-bold tracking-[0.14em] text-moon-100">{b.name}</p>
          </li>
        ))}
      </ul>

      <div class="mt-12" data-reveal style="--reveal-delay:420ms">
        <a href="/site/events#dragon-trial" class="btn btn-line group rounded-sm px-9 py-4 text-[15px]">
          查看活動完整規則
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
