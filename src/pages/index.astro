---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { dragonTrial } from '../data/events';
import { newSystems141, privilegeFeatures, convenienceFeatures, gameplayFeatures } from '../data/features';

const highlights = [
  privilegeFeatures[0], // VIP 尊榮系統
  convenienceFeatures[0], // 自動喝水系統
  convenienceFeatures[1], // 社群面板
  gameplayFeatures[0], // 離線擺攤
  gameplayFeatures[1], // 冠軍怪物系統
  privilegeFeatures[3], // 自動拾取道具
];
---

<Base>
  <Hero />

  <!-- 數據帶 — 全幅 cinematic 風格 -->
  <section class="relative border-y border-moon-100/5 bg-ink-900/40 backdrop-blur-sm" aria-label="伺服器數據">
    <div class="mx-auto grid max-w-7xl grid-cols-3 px-5 sm:grid-cols-3 md:grid-cols-6 md:px-8">
      {site.stats.rates.map((r, i) => (
        <div class="stat-item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <p class="stat-value text-3xl md:text-[2.8rem]">
            {r.value}<span class="stat-suffix">{r.suffix}</span>
          </p>
          <p class="stat-label">{r.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 14.1 新系統亮點 — Editorial Showcase -->
  <section class="relative mx-auto max-w-7xl px-5 py-28 md:px-8 md:py-40" aria-labelledby="new-systems">
    <SectionHead
      eyebrow="VERSION 14.1"
      title="闇鴉武士・全新系統"
      desc="重生系統、附魔挑戰、龍之試煉 — 14.1 帶來的嶄新戰場，等你親手寫下新的傳說。"
    />
    <div class="mt-16 md:mt-20">
      <FeatureShowcase features={newSystems141} />
    </div>
  </section>

  <!-- 裝飾分隔 -->
  <div class="section-divider mx-auto max-w-7xl px-5 md:px-8" aria-hidden="true">
    <span class="section-divider-icon"></span>
  </div>

  <!-- 特色預覽 — Feature Strip -->
  <section class="cinematic-section py-28 md:py-40" aria-labelledby="feature-preview">
    <img
      src="/site/assets/img/visual-samurai.webp"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="cinematic-bg"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-950/55 to-ink-950" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
      <SectionHead
        eyebrow="FEATURES"
        title="為玩家而生的細節"
        desc="從自動喝水到離線擺攤，每一項設計都為了讓你專注於戰鬥與冒險本身。"
      />
      <div class="mt-16 md:mt-20">
        <FeatureStrip features={highlights} />
      </div>
      <div class="mt-14 text-center" data-reveal>
        <a
          href="/site/features"
          class="group inline-flex items-center gap-2.5 border-b border-crimson-500/50 pb-1.5 text-[15px] font-medium tracking-[0.2em] text-crimson-300 transition-colors hover:text-moon-100"
        >
          瀏覽全部特色系統
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- 龍之試煉預告 — Cinematic 增強 -->
  <section class="relative overflow-hidden py-32 md:py-48" aria-labelledby="dragon-teaser">
    <video
      data-bg-video
      class="absolute inset-0 h-full w-full object-cover"
      src="/site/assets/video/dragon.mp4"
      poster={dragonTrial.poster}
      loop
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 bg-ink-950/68" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-transparent to-ink-950" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-5xl px-5 text-center md:px-8">
      <p class="inline-flex items-center gap-2 rounded-sm border border-gold-500/40 bg-ink-950/55 px-4 py-1.5 text-xs font-medium tracking-[0.32em] text-gold-300 backdrop-blur-sm" data-reveal>
        {dragonTrial.badge}
      </p>
      <h2 class="mt-6 font-display text-4xl font-black tracking-[0.1em] text-moon-100 md:text-6xl" data-reveal style="--reveal-delay:120ms">
        龍之試煉<span class="text-crimson-400">・絕</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-[15px] leading-8 text-moon-200/90" data-reveal style="--reveal-delay:220ms">
        {dragonTrial.intro}
      </p>

      <!-- Boss Badges — 大型視覺徽章 -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4" data-reveal style="--reveal-delay:320ms">
        {dragonTrial.bosses.map((b) => (
          <div class="boss-badge" style={`--boss-color: ${b.color}`}>
            <span class="boss-dot"></span>
            <span class="font-display text-lg font-black tracking-[0.12em] text-moon-100">{b.name}</span>
            <span class="text-[11px] tracking-[0.24em] text-moon-500">{b.title}</span>
          </div>
        ))}
      </div>

      <div class="mt-12" data-reveal style="--reveal-delay:420ms">
        <a
          href="/site/events"
          class="group inline-flex items-center gap-2.5 rounded-sm border border-crimson-500/50 bg-crimson-600/15 px-8 py-3.5 text-[15px] font-bold tracking-[0.2em] text-crimson-300 backdrop-blur-sm transition-all duration-300 hover:bg-crimson-600/35 hover:text-moon-100"
        >
          查看活動完整規則
          <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" />
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
