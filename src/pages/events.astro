---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { dragonTrial, clanRally } from '../data/events';
---

<Base
  title="最新活動"
  description="龍之試煉・絕與血盟集結令同步登場 — 挑戰四大巨龍、掌握極限時限機制，贏取傳奇神兵與殷海薩金幣獎勵。"
>
  <PageHero
    eyebrow="EVENTS"
    title="最新活動"
    desc="掌握極限討伐機制，奪取頂級神兵；壯大血盟陣營，全體共領殷海薩金幣。"
    image="/site/assets/img/visual-bloodmoon.webp"
    imageAlt="血月之下的武士剪影"
    anchors={[
      { href: '#dragon-trial', label: '龍之試煉・絕' },
      { href: '#clan-growth', label: '血盟集結令' },
    ]}
  />

  <!-- ══════════ 龍之試煉・絕 ══════════ -->
  <section id="dragon-trial" class="relative scroll-mt-20" aria-labelledby="dragon-trial-title">
    <div class="relative overflow-hidden">
      <video
        data-bg-video
        class="absolute inset-0 h-full w-full object-cover opacity-40"
        src={dragonTrial.video}
        poster={dragonTrial.poster}
        loop
        muted
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-950/60 to-ink-950" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-5 py-28 md:px-8 md:py-40">
        <div class="mb-4 text-center" data-reveal>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-crimson-400/30 bg-crimson-500/10 px-3.5 py-1 text-xs font-semibold tracking-[0.2em] text-crimson-400">
            <Icon name="dragon" class="h-3.5 w-3.5" />
            {dragonTrial.badge}
          </span>
        </div>

        <SectionHead
          eyebrow="WEEKEND RAID"
          title={dragonTrial.name}
          desc={dragonTrial.intro}
        />

        <!-- 四龍視覺徽章 -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal>
          {dragonTrial.bosses.map((b) => (
            <div class="boss-badge" style={`--boss-color: ${b.color}`}>
              <span class="boss-dot"></span>
              <span class="font-display text-base font-bold tracking-[0.12em] text-moon-100">{b.name}</span>
              <span class="text-[10px] tracking-[0.24em] text-moon-500">{b.title}</span>
            </div>
          ))}
        </div>

        <!-- 開放時間 & 鐵律 — 並排簡約面板 -->
        <div class="mt-14 grid gap-px overflow-hidden rounded-sm border border-moon-100/8 bg-moon-100/6 sm:grid-cols-2" data-reveal>
          <div class="bg-ink-950/90 p-7 backdrop-blur-sm">
            <p class="inline-flex items-center gap-2 font-latin text-xs font-semibold tracking-[0.3em] text-crimson-400">
              <Icon name="clock" class="h-4 w-4" />
              開放時間
            </p>
            <h3 class="mt-3 font-display text-xl font-bold tracking-[0.08em] text-moon-100">
              {dragonTrial.limits.schedule}
            </h3>
            <p class="mt-2 text-xs tracking-[0.14em] text-moon-500">
              ※ {dragonTrial.limits.scheduleNote}
            </p>
          </div>
          <div class="bg-ink-950/90 p-7 backdrop-blur-sm">
            <p class="inline-flex items-center gap-2 font-latin text-xs font-semibold tracking-[0.3em] text-gold-300">
              <Icon name="skull" class="h-4 w-4" />
              核心通關鐵律
            </p>
            <ul class="mt-3 space-y-2 text-xs leading-6 tracking-[0.06em] text-moon-200">
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-crimson-400"></span>
                <span>{dragonTrial.limits.iron1}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-crimson-400"></span>
                <span>{dragonTrial.limits.iron2}</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- 核心生死機制 — 編號步驟式（非卡片） -->
        <div class="mt-20 grid items-start gap-12 lg:grid-cols-[1.1fr_1fr]">
          <div data-reveal="left">
            <h3 class="font-display text-xl font-bold tracking-[0.12em] text-moon-100">
              核心生死機制
            </h3>
            <div class="mt-8">
              {dragonTrial.mechanics.map((m) => (
                <div class="mechanism-step">
                  <span class="mechanism-number">{m.number}</span>
                  <div>
                    <h4 class="font-display text-base font-bold tracking-[0.08em] text-moon-100">
                      {m.title}
                    </h4>
                    <p class="mt-2 text-sm leading-7 text-moon-300">{m.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <figure class="ink-frame overflow-hidden rounded-sm" data-reveal="right">
            <img
              src={dragonTrial.map}
              alt="龍之試煉活動地圖 — 安塔瑞斯之谷"
              loading="lazy"
              class="w-full transition-transform duration-[1.6s] ease-out hover:scale-[1.04]"
            />
            <figcaption class="flex items-center justify-center gap-2 border-t border-moon-100/8 bg-ink-950/70 px-4 py-3 text-xs tracking-[0.2em] text-moon-300">
              <Icon name="pin" class="h-3.5 w-3.5 text-crimson-400" />
              龍之試煉・活動地圖
            </figcaption>
          </figure>
        </div>

        <!-- 攻略戰術 + 掉落物 -->
        <div class="mt-20 grid items-start gap-12 lg:grid-cols-2">
          <!-- 戰術：純文字條列 -->
          <div data-reveal="left">
            <h3 class="font-display text-xl font-bold tracking-[0.12em] text-moon-100">
              基礎攻略戰術
            </h3>
            <div class="mt-8 space-y-6">
              {dragonTrial.tactics.map((t) => (
                <div class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-crimson-500/30 bg-crimson-500/10 font-latin text-xs font-bold text-crimson-400">
                    {t.letter}
                  </span>
                  <div>
                    <h4 class="font-display text-base font-bold tracking-[0.08em] text-moon-100">
                      {t.title}
                    </h4>
                    <p class="mt-1.5 text-sm leading-7 text-moon-300">{t.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- 掉落物：優雅 tag 展示 -->
          <div data-reveal="right">
            <h3 class="font-display text-xl font-bold tracking-[0.12em] text-gold-300">
              頂級專屬掉落物
            </h3>
            <div class="mt-8 flex flex-wrap gap-2.5">
              {dragonTrial.drops.map((drop) => (
                <span class="gold-breathe rounded-sm border border-gold-500/20 bg-ink-900/80 px-4 py-2 text-sm tracking-[0.06em] text-gold-200 transition-colors hover:border-gold-500/40 hover:text-gold-100">
                  {drop}
                </span>
              ))}
            </div>
            <div class="mt-8 flex items-start gap-3 rounded-sm border-l-2 border-gold-500/30 bg-ink-900/40 px-5 py-4">
              <span class="text-sm">💡</span>
              <p class="text-xs leading-6 text-moon-400">{dragonTrial.dropsTip}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 血盟集結令 ══════════ -->
  <section id="clan-growth" class="relative mx-auto max-w-7xl scroll-mt-20 px-5 py-28 md:px-8 md:py-40" aria-labelledby="clan-rally">
    <div class="mb-4 text-center" data-reveal>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-gold-400/30 bg-gold-500/10 px-3.5 py-1 text-xs font-semibold tracking-[0.2em] text-gold-300">
        <Icon name="shield" class="h-3.5 w-3.5" />
        {clanRally.badge}
      </span>
    </div>

    <SectionHead
      eyebrow="CLAN RALLY"
      title={clanRally.name}
      desc={clanRally.intro}
    />

    <div class="mt-16 grid items-start gap-12 lg:grid-cols-[1.15fr_1fr]">
      <!-- 左：獎勵表 — 保留表格（表格是好的佈局） -->
      <div class="overflow-hidden rounded-sm border border-moon-100/8" data-reveal="left">
        <div class="border-b border-moon-100/6 bg-ink-900/50 px-6 py-4">
          <h3 class="font-display text-lg font-bold tracking-[0.1em] text-moon-100">
            達標獎勵一覽
          </h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-moon-100/8 bg-ink-900/30 text-moon-400">
                <th class="px-6 py-3 font-semibold tracking-[0.1em]">達標在線人數</th>
                <th class="px-6 py-3 font-semibold tracking-[0.1em]">盟主獎勵</th>
                <th class="px-6 py-3 font-semibold tracking-[0.1em]">成員獎勵</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-moon-100/5 text-moon-200">
              {clanRally.table.map((row) => (
                <tr class="transition-colors hover:bg-ink-800/30">
                  <td class="px-6 py-3.5 font-display font-bold text-gold-300">{row.members} 人</td>
                  <td class="px-6 py-3.5 text-moon-300">殷海薩金幣 ×{row.leader}</td>
                  <td class="px-6 py-3.5 text-moon-300">殷海薩金幣 ×{row.member}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="border-t border-moon-100/6 bg-ink-950/40 px-6 py-3">
          <p class="text-[11px] tracking-[0.06em] text-moon-500">
            ※ {clanRally.tableNote}
          </p>
        </div>
      </div>

      <!-- 右：活動規則 — 純文字列表 + 策略提示 -->
      <div class="space-y-8" data-reveal="right">
        <div>
          <h3 class="font-display text-lg font-bold tracking-[0.1em] text-moon-100">
            活動規則
          </h3>
          <ul class="mt-6 space-y-4">
            {clanRally.rules.map((rule) => (
              <li class="flex items-start gap-3 text-sm leading-7 text-moon-300">
                <Icon name="check" class="mt-1.5 h-3.5 w-3.5 shrink-0 text-crimson-400" />
                <span>{rule}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex items-start gap-3 rounded-sm border-l-2 border-gold-500/30 bg-ink-900/40 px-5 py-4">
          <span class="text-sm">💡</span>
          <div>
            <p class="font-display text-xs font-bold tracking-[0.14em] text-gold-300">
              {clanRally.strategyLabel}
            </p>
            <p class="mt-1.5 text-xs leading-6 text-moon-300">
              {clanRally.strategy}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="戰友正在集結，獎勵正在倒數"
    desc="現在登入遊戲，挑戰龍之試煉、加入血盟，把頂級神兵與殷海薩金幣一次拿滿。"
  />
</Base>
