---
import Base from '../../layouts/Base.astro';
import ChapterHead from '../../components/ChapterHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import WikiPalette from '../../components/wiki/WikiPalette.astro';
import '../../styles/wiki.css';
import {
  WIKI_DB,
  wikiArticles,
  wikiCategories,
  wikiDbPages,
  wikiSchedule,
  wikiMeta,
  wikiBuiltDate,
  articlesIn,
  pageUrl,
  resolveWikiHref,
} from '../../data/wiki';
import { wikiIcon } from '../../data/wikiIcons';

const fmt = (n: number) => n.toLocaleString('en-US');
const hot = ['newbie', 'enchant', 'instances', 'bosses', 'zones'].map((id) => wikiArticles.find((p) => p.id === id)).filter(Boolean);
---

<Base
  title="攻略百科"
  description={`黑貓神話・闇鴉武士攻略百科：${wikiArticles.length} 篇攻略＋道具、怪物掉落、BOSS、商店等 9 大資料庫。新手照著做，老手直接查，數值全部取自伺服器實際設定。`}
>
  <div class="wiki-root" data-wiki-mode="hub">
    <!-- 主視覺：標題 + 搜尋 -->
    <section class="relative flex min-h-[64svh] items-end overflow-hidden pt-16" aria-labelledby="wh-title">
      <img
        src="/site/assets/img/visual-ink-samurai.webp"
        alt=""
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-[72%_22%]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950/85 via-ink-950/45 to-ink-950" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink-950/90 via-ink-950/45 to-transparent" aria-hidden="true"></div>

      <div class="relative mx-auto w-full max-w-7xl px-5 pb-16 pt-28 md:px-8 md:pb-20">
        <p class="font-latin text-xs font-semibold tracking-[0.44em] text-crimson-400" data-reveal>FIELD MANUAL</p>
        <h1 id="wh-title" class="mt-4 font-display text-5xl font-black tracking-[0.12em] text-moon-100 md:text-7xl" data-reveal style="--reveal-delay:120ms">
          攻略百科
        </h1>
        <p class="mt-5 max-w-xl text-[15px] leading-8 text-moon-300" data-reveal style="--reveal-delay:200ms">
          新手照著做，老手直接查。{wikiArticles.length} 篇攻略、9 大資料庫，數值全部取自伺服器實際設定。
        </p>

        <div class="mt-9 max-w-2xl" data-reveal style="--reveal-delay:280ms">
          <button type="button" class="wh-search group" data-wiki-search>
            <Fragment set:html={wikiIcon('search')} />
            <span>搜尋攻略、道具、怪物、掉落…</span>
            <kbd>/</kbd>
          </button>
          <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] tracking-[0.1em]">
            <span class="font-latin text-[10px] font-semibold tracking-[0.36em] text-moon-500">HOT</span>
            {hot.map((p) => (
              <a href={pageUrl(p!.id)} class="text-moon-300 transition-colors hover:text-crimson-300">{p!.title}</a>
            ))}
            <a href={`${WIKI_DB}#db-items`} class="text-moon-300 transition-colors hover:text-crimson-300">道具資料庫</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 全部攻略 -->
    <section class="relative z-[1] py-16 md:py-24" aria-labelledby="wh-all">
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-900/50 to-ink-950" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-5 md:px-8">
        <ChapterHead no="卷" en="ALL GUIDES" title="全部攻略" desc={`${wikiArticles.length} 篇，依主題分成六卷。`} />
        <div class="wh-cats mt-14" id="wh-all">
          {wikiCategories.map((cat, i) => {
            const list = articlesIn(cat.id);
            return (
              <div class="wh-cat" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                <div class="wh-cat-head">
                  <span class="wh-cat-no" aria-hidden="true">{cat.no}</span>
                  <div>
                    <p class="wh-cat-en">{cat.en}</p>
                    <h3 class="wh-cat-name">{cat.name}</h3>
                  </div>
                  <span class="wh-cat-count">{String(list.length).padStart(2, '0')}</span>
                </div>
                <ul>
                  {list.map((p) => (
                    <li>
                      <a href={pageUrl(p.id)}>
                        <b>{p.title}</b>
                        <span>{p.summary}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 資料庫 -->
    <section class="relative z-[1] mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28" aria-labelledby="wh-db">
      <ChapterHead no="典" en="DATABASE" title="資料庫" desc="道具、怪物、掉落、商店，一查就有。" />
      <div class="db-home-grid wh-db mt-14" id="wh-db" data-reveal>
        {wikiDbPages.map((p) => (
          <a href={`${WIKI_DB}#${p.id}`}>
            <Fragment set:html={wikiIcon(p.icon)} />
            <b>{p.title}</b>
            <span>{p.summary}</span>
            {p.count && <em>{fmt(Number(wikiMeta[p.count]))} {p.unit}</em>}
          </a>
        ))}
      </div>
    </section>

    <!-- 行事曆 -->
    <section class="relative z-[1] py-16 md:py-24" aria-labelledby="wh-time">
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-900/50 to-ink-950" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-5 md:px-8">
        <ChapterHead no="時" en="SCHEDULE" title="固定時間行事曆" desc="以伺服器時間為準，點一下看詳細。" />
        <div class="wh-sched mt-14" id="wh-time">
          {[
            { label: '每天', en: 'DAILY', rows: wikiSchedule.daily },
            { label: '每週', en: 'WEEKLY', rows: wikiSchedule.weekly },
          ].map((g, gi) => (
            <div data-reveal style={`--reveal-delay:${gi * 90}ms`}>
              <p class="wh-sched-head"><span>{g.label}</span><i>{g.en}</i></p>
              <ul>
                {g.rows.map(([time, text, link]) => (
                  <li>
                    <a href={resolveWikiHref(`#${link}`)}>
                      <time>{time}</time>
                      <span>{text}</span>
                      <b aria-hidden="true">→</b>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="wh-sched-note" data-reveal>{wikiSchedule.note}</p>
      </div>
    </section>

    <p class="relative z-[1] mx-auto max-w-7xl px-5 pb-6 text-xs tracking-[0.08em] text-moon-600 md:px-8">
      資料版本 {wikiBuiltDate}・道具 {fmt(wikiMeta.items)}・怪物 {fmt(wikiMeta.mobs)}・兌換表 {fmt(wikiMeta.multisells)}。數值取自本伺服器，可能和官方版本不同。
    </p>
  </div>

  <CtaBand title="照著攻略，踏上亞丁大陸" desc="還沒安裝？先到下載專區取得客戶端；卡關時，Discord 社群隨時有人幫你。" />
  <WikiPalette />
</Base>

<style>
  /* 主視覺搜尋列 */
  .wh-search {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    height: 3.6rem;
    padding: 0 1.1rem 0 1.25rem;
    border: 1px solid rgb(239 234 219 / 0.2);
    background: rgb(6 6 9 / 0.62);
    color: var(--w-muted);
    font-size: 0.98rem;
    letter-spacing: 0.08em;
    backdrop-filter: blur(10px);
    cursor: text;
    transition: border-color 0.4s var(--w-ease), box-shadow 0.4s var(--w-ease);
  }
  .wh-search :global(.ico) { width: 1.25rem; height: 1.25rem; color: var(--w-crimson-hi); }
  .wh-search span { flex: 1; text-align: left; }
  .wh-search:hover { border-color: rgb(224 70 60 / 0.6); box-shadow: 0 0 0 4px rgb(200 50 60 / 0.08), 0 20px 50px -20px rgb(200 50 60 / 0.35); }

  /* 全部攻略：分欄瀑布排列，避免長短不一留下大片空白 */
  .wh-cats { columns: 3; column-gap: 3rem; }
  .wh-cat { break-inside: avoid; display: inline-block; width: 100%; margin-bottom: 3.25rem; }
  .wh-cat-head { display: flex; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--w-line-2); position: relative; }
  .wh-cat-head::after { content: ""; position: absolute; left: 0; bottom: -1px; width: 3rem; height: 1px; background: var(--w-crimson-hi); }
  .wh-cat-no {
    font-family: var(--f-display);
    font-size: 2.9rem;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(224 70 60 / 0.7);
  }
  .wh-cat-en { font-family: var(--f-latin); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.34em; color: var(--w-crimson-hi); }
  .wh-cat-name { margin-top: 0.2rem; font-family: var(--f-display); font-size: 1.2rem; font-weight: 900; letter-spacing: 0.1em; color: var(--w-strong); }
  .wh-cat-count { margin-left: auto; font-family: var(--f-latin); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--w-faint); }
  .wh-cat li a {
    display: block;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--w-line);
    transition: padding 0.5s var(--w-ease), background-color 0.4s;
  }
  .wh-cat li a b { display: block; color: var(--w-text-2); font-size: 0.93rem; font-weight: 500; letter-spacing: 0.04em; transition: color 0.3s; }
  .wh-cat li a span { display: block; margin-top: 0.1rem; color: var(--w-faint); font-size: 0.76rem; letter-spacing: 0.03em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: color 0.3s; }
  .wh-cat li a:hover { padding-left: 0.85rem; background: linear-gradient(90deg, rgb(200 50 60 / 0.1), transparent 75%); }
  .wh-cat li a:hover b { color: var(--w-strong); }
  .wh-cat li a:hover span { color: var(--w-muted); }

  /* 資料庫 */
  .wh-db a { min-height: 9.5rem; }

  /* 行事曆 */
  .wh-sched { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  .wh-sched-head { display: flex; align-items: baseline; gap: 0.8rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--w-line-2); position: relative; }
  .wh-sched-head::after { content: ""; position: absolute; left: 0; bottom: -1px; width: 3rem; height: 1px; background: var(--w-crimson-hi); }
  .wh-sched-head span { font-family: var(--f-display); font-size: 1.3rem; font-weight: 900; letter-spacing: 0.14em; color: var(--w-strong); }
  .wh-sched-head i { font-style: normal; font-family: var(--f-latin); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.36em; color: var(--w-crimson-hi); }
  .wh-sched li a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "time arrow" "text arrow";
    align-items: center;
    column-gap: 1rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--w-line);
    transition: padding 0.5s var(--w-ease), background-color 0.4s;
  }
  .wh-sched time { grid-area: time; color: var(--w-gold-hi); font-size: 0.8rem; font-variant-numeric: tabular-nums; letter-spacing: 0.06em; }
  .wh-sched li a span { grid-area: text; color: var(--w-text-2); font-size: 0.92rem; letter-spacing: 0.03em; transition: color 0.3s; }
  .wh-sched li a b { grid-area: arrow; color: var(--w-faint); font-weight: 400; transition: transform 0.4s var(--w-ease), color 0.3s; }
  .wh-sched li a:hover { padding-left: 0.85rem; background: linear-gradient(90deg, rgb(200 50 60 / 0.1), transparent 75%); }
  .wh-sched li a:hover span { color: var(--w-strong); }
  .wh-sched li a:hover b { color: var(--w-crimson-soft); transform: translateX(4px); }
  .wh-sched-note { margin-top: 1.6rem; padding-left: 1rem; border-left: 2px solid var(--w-gold); font-size: 0.86rem; color: var(--w-text); letter-spacing: 0.03em; }

  @media (max-width: 900px) {
    .wh-sched { grid-template-columns: minmax(0, 1fr); }
    .wh-cats { columns: 1; }
  }
</style>
