---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import type { Feature } from '../data/features';
import {
  privilegeFeatures,
  convenienceFeatures,
  gameplayFeatures,
  pvpFeatures,
} from '../data/features';

interface Category {
  no: string;
  en: string;
  title: string;
  desc: string;
  items: Feature[];
}

const categories: Category[] = [
  {
    no: '壹',
    en: 'PREMIUM',
    title: '尊榮特權',
    desc: 'VIP 雙倍加成、創角即贈一億資金 — 讓每一位玩家都能從容踏上征途。',
    items: privilegeFeatures,
  },
  {
    no: '貳',
    en: 'CONVENIENCE',
    title: '便利功能',
    desc: '自動喝水、社群面板、一鍵 Buff — 把繁瑣交給系統，把精力放在戰鬥。',
    items: convenienceFeatures,
  },
  {
    no: '參',
    en: 'GAMEPLAY',
    title: '遊戲系統',
    desc: '離線擺攤、冠軍怪物、外觀變更 — 長線經營的深度與自由，一應俱全。',
    items: gameplayFeatures,
  },
  {
    no: '肆',
    en: 'PVP ARENA',
    title: 'PvP 競技',
    desc: '擊殺獎勵、全服廣播、稱號染色 — 在這片戰場，實力就是唯一的語言。',
    items: pvpFeatures,
  },
];
---

<Base title="特色系統" description="黑貓神話 14.1 闇鴉武士特色系統：VIP 尊榮雙倍、自動喝水、離線擺攤、冠軍怪物、PvP 競技獎勵，二十餘項精心設計，為玩家而生的天堂II私服。">
  <PageHero
    eyebrow="FEATURES"
    title="特色系統"
    desc="二十餘項精心打磨的系統，四幕一覽 — 從新手到霸主，每一步都有最好的體驗。"
    image="/site/assets/img/visual-samurai.webp"
    imageAlt="水墨風格的白髮武士"
  />

  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="space-y-28 md:space-y-40">
      {categories.map((c, ci) => (
        <section aria-labelledby={`cat-${ci}`} class="relative">
          <div class="grid gap-10 lg:grid-cols-[340px_1fr] lg:gap-16">
            <div class="lg:sticky lg:top-28 lg:self-start" data-reveal="left">
              <span class="chapter-no text-[5.5rem] md:text-[7rem]" aria-hidden="true">{c.no}</span>
              <p class="font-latin mt-2 text-[11px] font-semibold tracking-[0.5em] text-moon-500">{c.en}</p>
              <h2 id={`cat-${ci}`} class="mt-2 font-display text-3xl font-black tracking-[0.1em] text-moon-100 md:text-4xl" data-chars data-reveal>
                {c.title}
              </h2>
              <div class="rule-line-crimson mt-6 w-20" data-reveal="line" aria-hidden="true"></div>
              <p class="mt-5 max-w-xs text-sm leading-7 text-moon-300">{c.desc}</p>
              <p class="tnum mt-4 font-latin text-xs tracking-[0.35em] text-moon-600">{String(c.items.length).padStart(2, '0')} SYSTEMS</p>
            </div>

            <ol class="divide-y divide-moon-100/8 border-y border-moon-100/8">
              {c.items.map((f, i) => (
                <li class="list-row group flex items-start gap-5 py-6 md:py-7" data-reveal style={`--reveal-delay:${i * 50}ms`}>
                  <span class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center border border-moon-100/12 text-crimson-300 transition-colors duration-500 group-hover:border-crimson-500/50 group-hover:bg-crimson-600/10">
                    <Icon name={f.icon} class="h-5 w-5" />
                  </span>
                  <div class="flex-1">
                    <h3 class="flex flex-wrap items-center gap-3 font-display text-lg font-bold tracking-[0.08em] text-moon-100 md:text-xl">
                      <span class="tnum mr-1 font-latin text-xs font-normal text-moon-600">0{i + 1}</span>
                      {f.title}
                      {f.tag && (
                        <span class="border border-gold-500/30 px-2 py-0.5 text-[10px] font-medium tracking-[0.28em] text-gold-300">{f.tag}</span>
                      )}
                    </h3>
                    <p class="mt-1.5 max-w-2xl text-sm leading-7 text-moon-300">{f.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      ))}
    </div>
  </div>

  <CtaBand title="心動了嗎？" desc="所有系統完全免費體驗。現在加入，即刻領取一億創角資金，展開你的傳說。" />
</Base>
