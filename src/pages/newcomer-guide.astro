---
/** 舊網址相容：新人攻略已整合為「攻略百科」，舊連結自動轉到新頁 */
const target = '/site/wiki';
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>攻略百科 - 黑貓神話 闇鴉武士</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#060609;color:#b8b4a6;font-family:'Noto Sans TC',sans-serif;letter-spacing:.08em">
    <p>新人攻略已改版為 <a href={target} style="color:#f06a54">攻略百科</a>，正在前往…</p>
  </body>
</html>
