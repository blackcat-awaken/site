---
import '../styles/global.css';
import { site } from '../data/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** 相對路徑，例 '/assets/img/og-image.jpg' */
  image?: string;
  /** 內容頁可使用 noindex 等 */
  robots?: string;
}

const {
  title,
  description = site.description,
  image = '/site/assets/img/og-image.jpg',
  robots = 'index, follow',
} = Astro.props;

const pageTitle = title
  ? `${title} - ${site.brand} ${site.title}`
  : `${site.brand} ${site.title} - 天堂II 14.1 覺醒伺服器`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-Hant" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <!-- 強制桌機版：手機也以 1024 寬度渲染，瀏覽器自動縮放顯示完整桌機版面 -->
    <meta name="viewport" content="width=1024" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content={site.brand} />
    <meta name="theme-color" content="#0b0b10" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.brand} ${site.title}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/site/favicon.png" />
    <link rel="apple-touch-icon" href="/site/favicon.png" />

    <!-- 字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@600;700;900&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: `${site.brand} ${site.title}`,
      alternateName: [`${site.brand}・${site.title}`, site.titleEn],
      url: Astro.site?.toString(),
      description: site.description,
      inLanguage: 'zh-Hant',
    })} />
    <slot name="head" />
  </head>

  <body class="grain bg-ink-950 text-moon-100 min-h-screen flex flex-col antialiased">
    <div class="ambient" aria-hidden="true"></div>
    <Navbar />
    <main class="flex-1 relative z-[1]">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
